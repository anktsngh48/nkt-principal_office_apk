<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the system while the app starts: white splash with the logo. -->
    <style name="Theme.PrincipalsOffice.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PrincipalsOffice</item>
    </style>

    <!-- The app itself: full-screen page, no action bar. -->
    <style name="Theme.PrincipalsOffice" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
